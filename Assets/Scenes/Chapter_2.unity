    - target: {fileID: 8728007352356023310, guid: fd1497cde0ae0d04ba26cdaba77db3d2, type: 3}
      propertyPath: m_text
      value: "public static int MagicFunction(int num)\r\n{\r\n    int result = num
        + 5;\r\n    if (num % 2 == 0)\r\n    {\r\n        result = result * 2;\r\n   
        }\r\n    else\r\n    {\r\n        result = result - 2;\r\n    }\r\n    return
        result;\r\n}\r\n"
      objectReference: {fileID: 0}
